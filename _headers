# Cloudflare Pages Global Security & Performance Headers
/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self' https://linkadda.online https://www.linkadda.online https://web.telegram.org https://*.telegram.org;
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Admin Security: Never cache, never allow search engine indexing
/admin/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive

/.env*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive

# Static JS & CSS: Edge caching with revalidation
/*.js
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/*.css
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

# Immutable Media & Fonts (Max Edge CDN Speed)
/images/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# Admin Security & Instant Freshness Override (Must be at end so it overrides /*.js)
/admin/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive

/admin/js/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive
