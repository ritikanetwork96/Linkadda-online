{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'botforword@gmail.com' || auth.token.email.toLowerCase() === 'botforword@gmail.com')",
      ".indexOn": ["displayOrder", "updatedAt", "createdAt", "status"]
    },
    "categories": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'botforword@gmail.com' || auth.token.email.toLowerCase() === 'botforword@gmail.com')",
      ".indexOn": ["displayOrder", "updatedAt", "createdAt", "status"]
    },
    "banner": {
